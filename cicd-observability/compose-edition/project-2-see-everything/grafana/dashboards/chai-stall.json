  {
   "id": 17,
   "type": "row",
   "title": "Logs (Loki): same app, same time range",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Log lines per second by level",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "expr": "sum by (level) (count_over_time({service=~\"chai-.*\"} | json | __error__=\"\" [30s]))",
     "legendFormat": "{{level}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
