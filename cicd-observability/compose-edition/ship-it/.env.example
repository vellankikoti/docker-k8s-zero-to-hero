# Copy to .env and edit. .env is git-ignored: this is how secrets reach Jenkins without touching Git.
JENKINS_ADMIN_PASSWORD=z2h-jenkins
DEPLOY_TOKEN=s3cr3t-deploy-token-42
REGISTRY_PASSWORD=not-a-real-password
# Which Git repo and branch Jenkins builds. The default is the copy mounted from your laptop.
REPO_URL=file:///repo
REPO_BRANCH=*/main
