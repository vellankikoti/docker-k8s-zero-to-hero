// Pipeline as Code: the whole CI/CD process for the Chai Stall, versioned in Git next to the code.
// Declarative syntax: Jenkins validates the structure before running anything.
pipeline {
  agent any                         // run on any executor. K20 shows agents as Kubernetes Pods instead.

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()       // two deploys at once would fight over the same containers
    buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
  }

  parameters {                      // become the "Build with Parameters" form
    choice(name: 'STRATEGY', choices: ['bluegreen', 'canary', 'rolling'], description: 'How to release to production')
    string(name: 'CANARY_PERCENT', defaultValue: '20', description: 'Canary only: percent of traffic for the new version')
    booleanParam(name: 'INJECT_BUG', defaultValue: false, description: 'Pretend this release has a bug (30% of orders fail)')
    choice(name: 'SCAN_MODE', choices: ['enforce', 'report', 'skip'], description: 'enforce = a CRITICAL vulnerability fails the build')
    booleanParam(name: 'REQUIRE_APPROVAL', defaultValue: true, description: 'Ask a human before touching production')
  }

  environment {                     // plain, non-secret settings
    REGISTRY   = 'localhost:5001'
    NAME       = 'chai-stall'
    VERSION    = "1.0.${env.BUILD_NUMBER}"
    FULL_IMAGE = "${REGISTRY}/${NAME}:${VERSION}"
    APP_DIR    = 'cicd-observability/app'
    HERE       = 'cicd-observability/projects/project-1-ship-it'
    CHAOS_ERROR_RATE = "${params.INJECT_BUG ? '0.3' : '0'}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty="commit %h by %an: %s"'
      }
    }

    stage('Test') {
      steps {
        dir(env.APP_DIR) {
          // Keep the exit code of the tests. (A plain "tests | tee file" would return tee's exit code, 0,
          // and a failing test would NOT fail the build: Jenkins' sh has no "pipefail".)
          sh '''
            python3 -m unittest discover -s tests -v > "$WORKSPACE/test-output.txt" 2>&1; rc=$?
            cat "$WORKSPACE/test-output.txt"
            exit $rc
          '''
        }
      }
    }

    stage('Checks in parallel') {
      parallel {
        stage('Secret scan') {
          steps { sh '$HERE/scripts/secret-scan.sh $APP_DIR $HERE/deploy' }
        }
        stage('Syntax check') {
          steps { sh 'python3 -m py_compile $APP_DIR/app.py && echo "✔ app.py compiles"' }
        }
      }
    }

    stage('Build image') {
      steps {
        sh 'docker build --build-arg APP_VERSION=$VERSION -t $FULL_IMAGE $APP_DIR'
        sh '$HERE/scripts/image-policy.sh $FULL_IMAGE'
      }
    }

    stage('Scan image') {
      when { expression { params.SCAN_MODE != 'skip' } }
      steps {
        // Trivy runs as a container, scanning the image we just built. CRITICAL findings fail the build in 'enforce' mode.
        sh '''
          EXIT=1; [ "$SCAN_MODE" = report ] && EXIT=0
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ \
            aquasec/trivy:0.58.1 image --no-progress --severity CRITICAL --exit-code $EXIT $FULL_IMAGE
        '''
      }
    }

    stage('Push to registry') {
      steps {
        // The password is injected for these few lines only, masked in the log, and kept out of ~/.docker.
        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''
            export DOCKER_CONFIG="$WORKSPACE/.docker"; mkdir -p "$DOCKER_CONFIG"
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin $REGISTRY
            docker push $FULL_IMAGE
            docker logout $REGISTRY
          '''
        }
        sh '''
          DIGEST=$(docker inspect --format '{{index .RepoDigests 0}}' $FULL_IMAGE)
          printf '{"version":"%s","image":"%s","digest":"%s","commit":"%s","build":"%s"}\\n' \
            "$VERSION" "$FULL_IMAGE" "$DIGEST" "$(git rev-parse --short HEAD)" "$BUILD_NUMBER" | tee build-info.json
        '''
        archiveArtifacts artifacts: 'build-info.json, test-output.txt', fingerprint: true
      }
    }

    stage('Deploy to staging') {
      steps { sh '$HERE/deploy/deploy.sh staging $FULL_IMAGE' }
    }

    stage('Approval') {
      when { expression { params.REQUIRE_APPROVAL } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          input message: "Staging runs ${VERSION} at http://localhost:8081. Release it to production with ${params.STRATEGY}?", ok: 'Ship it'
        }
      }
    }

    stage('Release to production') {
      steps {
        script {
          if (params.STRATEGY == 'rolling') {
            sh '$HERE/deploy/deploy.sh rolling $FULL_IMAGE'
          } else if (params.STRATEGY == 'bluegreen') {
            sh '$HERE/deploy/deploy.sh bluegreen $FULL_IMAGE'
          } else {
            sh '$HERE/deploy/deploy.sh canary $FULL_IMAGE ${CANARY_PERCENT}'
            // Automated canary analysis: look at real traffic, then decide. No human needed.
            def verdict = sh(script: '$HERE/scripts/canary-check.sh 200 5', returnStatus: true)
            if (verdict != 0) {
              sh '$HERE/deploy/deploy.sh rollback'
              error 'Canary failed its health check: rolled back automatically.'
            }
            sh '$HERE/deploy/deploy.sh promote'
          }
        }
      }
    }
  }

  post {
    success { echo "✅ ${VERSION} is live: http://localhost:8090" }
    failure { echo "❌ Build failed: open the first red stage above. Stages after it were skipped, so they did not run." }
    always  { sh 'docker logout $REGISTRY >/dev/null 2>&1 || true' }
  }
}
