// Lab C04: a secret exists only inside withCredentials, is masked in the log, and can STILL be leaked by anyone who can edit this file.
pipeline {
  agent { kubernetes { yamlFile 'ci/pod.yaml'; defaultContainer 'tools' } }
  options { skipDefaultCheckout(); timestamps() }
  stages {
    stage('Use a secret') {
      steps {
        withCredentials([string(credentialsId: 'deploy-token', variable: 'TOKEN')]) {
          sh 'echo "1) printing it directly:   $TOKEN"'
          sh 'echo "2) length of the secret:   ${#TOKEN}"'
          sh 'echo "3) the same secret, reversed: $(echo $TOKEN | rev)"'
        }
        sh 'echo "4) outside the block:       [${TOKEN:-nothing here}]"'
      }
    }
  }
}
