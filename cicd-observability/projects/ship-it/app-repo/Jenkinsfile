// The Chai Stall pipeline, on Kubernetes. Pipeline as Code (Lab C02).
//
// This file says WHICH stages exist, in WHICH container each one runs, and when they run: the SHAPE of your pipeline.
// HOW a stage works is platform logic in /opt/z2h/stage.sh (read it: cicd-observability/k8s/pipeline/stage.sh). That keeps
// your repository small and means a fix to a stage reaches you with `git pull && k8s-up.sh`, without copying files around.
//
// Every build runs in its own Pod (ci/pod.yaml). Every deploy is a Helm release into a namespace that ENFORCES
// Pod Security "restricted". Every environment is a namespace; every release strategy is plain Kubernetes.
pipeline {
  agent { kubernetes { yamlFile 'ci/pod.yaml'; defaultContainer 'tools' } }

  options {
    skipDefaultCheckout()
    timestamps()
    ansiColor('xterm')
    timeout(time: 25, unit: 'MINUTES')
    disableConcurrentBuilds()               // two releases at once would fight over the same Deployments
    buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
  }

  parameters {
    choice(name: 'STRATEGY', choices: ['bluegreen', 'canary', 'rolling', 'recreate'], description: 'How to release to production')
    string(name: 'CANARY_PERCENT', defaultValue: '20', description: 'Canary only: percent of traffic for the new version')
    booleanParam(name: 'INJECT_BUG', defaultValue: false, description: 'Pretend this release has a bug (30% of orders fail)')
    choice(name: 'SCAN_MODE', choices: ['report', 'enforce', 'skip'], description: 'report = show findings, never block (default: works on any cluster). enforce = a CRITICAL vulnerability fails the build. skip = do not scan')
    booleanParam(name: 'REQUIRE_APPROVAL', defaultValue: true, description: 'Ask a human before touching production')
  }

  environment {
    PUSH_REGISTRY = 'registry.cicd.svc.cluster.local:5000'   // where a build Pod pushes (cluster DNS)
    PULL_REPO     = 'localhost:30500/chai-stall'              // where the node's kubelet pulls from (NodePort)
    TAG           = "1.0.${env.BUILD_NUMBER}"
    CHAOS_ERROR_RATE = "${params.INJECT_BUG ? '0.3' : '0'}"
    IMAGE_REPO    = "${PULL_REPO}"
    Z2H           = '/opt/z2h'                                // the platform's pipeline scripts (ConfigMap z2h-pipeline)
  }

  stages {
    stage('Checkout') {
      steps {
        container('jnlp') { checkout scm }
        sh 'git config --global --add safe.directory "$WORKSPACE" || true; git log -1 --pretty="commit %h by %an: %s"'
      }
    }

    stage('Test') {
      steps { container('python') { sh 'sh $Z2H/stage.sh test' } }
    }

    stage('Checks in parallel') {
      parallel {
        stage('Secret scan')                      { steps { sh 'sh $Z2H/stage.sh secret-scan' } }
        stage('Chart: lint + ask the API server') { steps { sh 'sh $Z2H/stage.sh chart-check' } }
      }
    }

    stage('Build image (Kaniko)') {
      steps { container('kaniko') { sh 'sh $Z2H/stage.sh build' } }
    }

    stage('Scan image (Trivy)') {
      when { expression { params.SCAN_MODE != 'skip' } }
      steps { container('trivy') { sh 'sh $Z2H/stage.sh scan' } }
    }

    stage('Record the artifact') {
      steps {
        sh 'sh $Z2H/stage.sh record'
        archiveArtifacts artifacts: 'build-info.json, test-output.txt', fingerprint: true
      }
    }

    stage('Deploy to staging') {
      steps { sh 'sh $Z2H/stage.sh deploy-staging' }
    }

    stage('Approval') {
      when { expression { params.REQUIRE_APPROVAL } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          input message: "Staging runs ${TAG}. Release it to production with ${params.STRATEGY}?", ok: 'Ship it'
        }
      }
    }

    stage('Release to production') {
      steps {
        script {
          if (params.STRATEGY == 'canary') {
            sh 'bash $Z2H/k8s-deploy.sh canary $TAG ${CANARY_PERCENT}'
            // Automated canary analysis: judge the canary ON ITS OWN traffic, then promote or roll back.
            def verdict = sh(script: 'bash $Z2H/k8s-deploy.sh analyse canary', returnStatus: true)
            if (verdict != 0) {
              sh 'bash $Z2H/k8s-deploy.sh rollback'
              error 'The canary failed its health check: rolled back automatically.'
            }
            sh 'bash $Z2H/k8s-deploy.sh promote'
          } else {
            sh "bash \$Z2H/k8s-deploy.sh ${params.STRATEGY} \$TAG"
          }
        }
      }
    }
  }

  post {
    success { echo "✅ ${TAG} is live in stall-prod. Look: kubectl -n stall-prod get deploy,httproute" }
    failure { echo "❌ Build failed: open the first red stage. Stages after it were skipped. A failed deploy prints its evidence (the ──── sections) before it rolls back." }
  }
}
