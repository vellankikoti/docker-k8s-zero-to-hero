{
  "checks": [
    {
      "name": "unit tests",
      "container": "python",
      "cmd": "cd app && python -m unittest discover -s tests"
    },
    {
      "name": "secret scan",
      "container": "tools",
      "cmd": "bash /opt/z2h/secret-scan.sh app chart ci"
    },
    {
      "name": "chart lint",
      "container": "tools",
      "cmd": "helm lint chart/chai-stall --set image.tag=lint"
    }
  ]
}